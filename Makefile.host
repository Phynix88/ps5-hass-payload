# Host build: unit tests, fuzzing, the host server for end-to-end tests.
# Runs on Linux (CI, buildhost) and macOS. Never talks to a PS5.
#
#   make -f Makefile.host test           unit tests with ASan/UBSan
#   make -f Makefile.host fuzz FUZZ_SECONDS=60   libFuzzer targets (Linux clang)
#   make -f Makefile.host host           build/ps5-hass-host (fake platform)
#   make -f Makefile.host e2e            end-to-end tests against the host server

CC ?= cc
PYTHON ?= python3
FUZZ_SECONDS ?= 60

# SQLite is third-party code: its own object, no sanitizers, no -Werror.
SQLITE_DEFS := -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_THREADSAFE=0 \
               -DSQLITE_DEFAULT_MEMSTATUS=0 -DSQLITE_OMIT_DEPRECATED \
               -DSQLITE_DQS=0 -DSQLITE_MAX_MMAP_SIZE=0
SQLITE_OBJ := build/sqlite3.o
SQLITE_INC := -Ithird_party/sqlite

SAN    := -fsanitize=address,undefined -fno-omit-frame-pointer
CFLAGS_HOST := -std=c11 -Wall -Wextra -Werror -g $(SAN) \
               -D_DEFAULT_SOURCE -D_DARWIN_C_SOURCE \
               -Isrc -Ithird_party/jsmn $(SQLITE_INC) \
               -DPS5H_VERSION=\"host\" -DPS5H_COMMIT=\"host\"
LDLIBS_HOST := -lpthread

HEADERS := $(wildcard src/*.h) tests/t.h
SRC_LIB := $(filter-out src/platform_ps5.c src/mdns.c src/main.c,$(wildcard src/*.c))
TESTS   := $(patsubst tests/%.c,build/tests/%,$(wildcard tests/test_*.c))

.PHONY: test fuzz host e2e clean

test: $(TESTS)
	@set -e; for t in $(TESTS); do ASAN_OPTIONS=strict_string_checks=1 $$t; done

$(SQLITE_OBJ): third_party/sqlite/sqlite3.c third_party/sqlite/sqlite3.h
	@mkdir -p $(dir $@)
	$(CC) -std=c11 -O1 -w -D_DEFAULT_SOURCE -D_DARWIN_C_SOURCE $(SQLITE_DEFS) \
	  -c -o $@ third_party/sqlite/sqlite3.c

build/tests/%: tests/%.c $(SRC_LIB) $(SQLITE_OBJ) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_HOST) -o $@ $< $(SRC_LIB) $(SQLITE_OBJ) $(LDLIBS_HOST)

clean:
	rm -rf build

# --- fuzzing (needs a clang with libFuzzer, e.g. nixpkgs clang on Linux) ---
FUZZ_CC ?= clang
FUZZ_FLAGS := -std=c11 -g -O1 -fsanitize=fuzzer,address,undefined \
              -D_DEFAULT_SOURCE -Isrc -Ithird_party/jsmn $(SQLITE_INC) \
              -DPS5H_VERSION=\"fuzz\" -DPS5H_COMMIT=\"fuzz\"
FUZZERS := $(patsubst tests/fuzz/%.c,build/fuzz/%,$(wildcard tests/fuzz/fuzz_*.c))

build/fuzz/sqlite3.o: third_party/sqlite/sqlite3.c third_party/sqlite/sqlite3.h
	@mkdir -p $(dir $@)
	$(FUZZ_CC) -std=c11 -O1 -w -D_DEFAULT_SOURCE $(SQLITE_DEFS) -c -o $@ \
	  third_party/sqlite/sqlite3.c

build/fuzz/%: tests/fuzz/%.c $(SRC_LIB) build/fuzz/sqlite3.o $(HEADERS)
	@mkdir -p $(dir $@)
	$(FUZZ_CC) $(FUZZ_FLAGS) -o $@ $< $(SRC_LIB) build/fuzz/sqlite3.o -lpthread

fuzz: $(FUZZERS)
	@set -e; for f in $(FUZZERS); do \
	  n=$$(basename $$f); c=tests/fuzz/corpus/$${n#fuzz_}; mkdir -p $$c build/fuzz/new-$$n; \
	  echo "== $$n ($(FUZZ_SECONDS) s)"; \
	  if ! $$f -max_total_time=$(FUZZ_SECONDS) -max_len=16384 build/fuzz/new-$$n $$c \
	       > build/fuzz/$$n.log 2>&1; then tail -40 build/fuzz/$$n.log; exit 1; fi; \
	  tail -2 build/fuzz/$$n.log; \
	done

# --- host server for end-to-end tests (fake platform, no mDNS) ---
host: build/ps5-hass-host

build/ps5-hass-host: src/main.c $(SRC_LIB) $(SQLITE_OBJ) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_HOST) -DPS5H_HOST -o $@ src/main.c $(SRC_LIB) $(SQLITE_OBJ) $(LDLIBS_HOST)

# --- end-to-end tests (pytest + jsonschema, see tests/e2e/requirements.txt) ---
e2e: build/ps5-hass-host
	$(PYTHON) -m pytest -q tests/e2e
