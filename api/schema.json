{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Phynix88/ps5-hass-payload/api/schema.json",
  "title": "ps5-hass API v1 responses",
  "description": "One definition per answer of /api/v1. Use {\"$ref\": \"#/$defs/<name>\"}.",
  "$defs": {
    "title_id": {
      "type": "string",
      "pattern": "^[A-Z]{4}[0-9]{5}$"
    },
    "opt_int": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ok": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "name": {
          "const": "ps5-hass"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "api": {
          "const": 1
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "model": {
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "paired": {
          "type": "boolean"
        },
        "power_actions": {
          "type": "boolean"
        },
        "config": {
          "enum": [
            "ok",
            "recovered"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "temps": {
              "type": "boolean"
            },
            "fan": {
              "type": "boolean"
            },
            "notify": {
              "type": "boolean"
            },
            "random": {
              "type": "boolean"
            },
            "launch": {
              "type": "boolean"
            },
            "standby": {
              "type": "boolean"
            },
            "mdns": {
              "type": "boolean"
            },
            "power_off": {
              "type": "boolean"
            },
            "fan_control": {
              "type": "boolean"
            },
            "focus": {
              "type": "boolean"
            },
            "power_state": {
              "type": "boolean"
            },
            "suspend": {
              "type": "boolean"
            },
            "keep_awake": {
              "type": "boolean"
            },
            "soc_power": {
              "type": "boolean"
            },
            "playtime": {
              "type": "boolean"
            },
            "payload_control": {
              "type": "boolean"
            }
          },
          "required": [
            "temps",
            "fan",
            "notify",
            "random",
            "launch",
            "standby",
            "mdns",
            "power_off",
            "fan_control",
            "focus",
            "power_state",
            "suspend",
            "keep_awake",
            "soc_power",
            "playtime",
            "payload_control"
          ],
          "additionalProperties": false
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        }
      },
      "required": [
        "result",
        "name",
        "version",
        "commit",
        "api",
        "device_id",
        "model",
        "firmware",
        "paired",
        "power_actions",
        "config",
        "capabilities",
        "last_error",
        "permissions"
      ],
      "additionalProperties": false
    },
    "pair_start": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "result",
        "expires_in"
      ],
      "additionalProperties": false
    },
    "pair_finish": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "result",
        "token"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "in_app": {
          "type": "boolean"
        },
        "app": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "title_id": {
                  "$ref": "#/$defs/title_id"
                },
                "name": {
                  "type": "string"
                },
                "app_id": {
                  "type": "integer"
                }
              },
              "required": [
                "title_id",
                "name",
                "app_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "temps": {
          "type": "object",
          "properties": {
            "cpu": {
              "$ref": "#/$defs/opt_int"
            },
            "soc": {
              "$ref": "#/$defs/opt_int"
            }
          },
          "required": [
            "cpu",
            "soc"
          ],
          "additionalProperties": false
        },
        "fan_raw": {
          "$ref": "#/$defs/opt_int"
        },
        "storage": {
          "type": "object",
          "properties": {
            "data_free_mb": {
              "$ref": "#/$defs/opt_int"
            },
            "data_total_mb": {
              "$ref": "#/$defs/opt_int"
            },
            "user_free_mb": {
              "$ref": "#/$defs/opt_int"
            },
            "user_total_mb": {
              "$ref": "#/$defs/opt_int"
            }
          },
          "required": [
            "data_free_mb",
            "data_total_mb",
            "user_free_mb",
            "user_total_mb"
          ],
          "additionalProperties": false
        },
        "soc_power": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "total_mw": {
                  "type": "integer",
                  "minimum": 0
                },
                "rails": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "mw": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "mv": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "ma": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "mw",
                      "mv",
                      "ma"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "total_mw",
                "rails"
              ],
              "additionalProperties": false
            }
          ]
        },
        "drives": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "m2",
                  "extended",
                  "usb0",
                  "usb1",
                  "usb2",
                  "usb3",
                  "usb4",
                  "usb5",
                  "usb6",
                  "usb7"
                ]
              },
              "free_mb": {
                "type": "integer",
                "minimum": 0
              },
              "total_mb": {
                "type": "integer",
                "minimum": 1024
              }
            },
            "required": [
              "name",
              "free_mb",
              "total_mb"
            ],
            "additionalProperties": false
          }
        },
        "uptime_s": {
          "type": "integer"
        },
        "payload_uptime_s": {
          "type": "integer"
        },
        "apps_etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "payloads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 19
          },
          "maxItems": 32
        },
        "fan": {
          "$ref": "#/$defs/fan_state"
        },
        "power_state": {
          "enum": [
            "on",
            "going_to_rest",
            "rest",
            "shutting_down",
            "unknown"
          ]
        },
        "keep_awake": {
          "type": "boolean"
        }
      },
      "required": [
        "result",
        "in_app",
        "app",
        "temps",
        "fan_raw",
        "storage",
        "soc_power",
        "drives",
        "uptime_s",
        "payload_uptime_s",
        "apps_etag",
        "payloads",
        "fan",
        "power_state",
        "keep_awake"
      ],
      "additionalProperties": false
    },
    "apps": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title_id": {
                "$ref": "#/$defs/title_id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "game",
                  "app"
                ]
              },
              "category": {
                "$ref": "#/$defs/opt_int"
              },
              "has_icon": {
                "type": "boolean"
              }
            },
            "required": [
              "title_id",
              "name",
              "version",
              "kind",
              "category",
              "has_icon"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "result",
        "etag",
        "apps"
      ],
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "already_running": {
          "type": "boolean"
        },
        "app_id": {
          "type": "integer"
        }
      },
      "required": [
        "result",
        "already_running"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "result": {
          "const": "error"
        },
        "error": {
          "enum": [
            "bad_request",
            "bad_title_id",
            "unauthorized",
            "wrong_code",
            "origin_forbidden",
            "browser_guard",
            "host_forbidden",
            "address_forbidden",
            "not_found",
            "not_installed",
            "method_not_allowed",
            "no_code",
            "code_exhausted",
            "token_limit",
            "other_app_running",
            "no_user",
            "title_mismatch",
            "no_app",
            "not_running",
            "not_on",
            "length_required",
            "body_too_large",
            "locked",
            "rate_limited",
            "headers_too_large",
            "notify_failed",
            "random_unavailable",
            "system_error",
            "internal",
            "fan_above_stock",
            "not_available",
            "already_allowed",
            "protected",
            "already_running",
            "unknown_payload",
            "payload_manager_unavailable"
          ]
        },
        "message": {
          "type": "string"
        },
        "attempts_left": {
          "type": "integer",
          "minimum": 0
        },
        "retry_after": {
          "type": "integer",
          "minimum": 0
        },
        "rc": {
          "type": "integer"
        },
        "rc_hex": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{8}$"
        }
      },
      "required": [
        "result",
        "error",
        "message"
      ],
      "additionalProperties": false
    },
    "fan_state": {
      "type": "object",
      "properties": {
        "target_c": {
          "$ref": "#/$defs/opt_int"
        },
        "current_c": {
          "$ref": "#/$defs/opt_int"
        },
        "stock_c": {
          "$ref": "#/$defs/opt_int"
        }
      },
      "required": [
        "target_c",
        "current_c",
        "stock_c"
      ],
      "additionalProperties": false
    },
    "fan": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "fan": {
          "$ref": "#/$defs/fan_state"
        }
      },
      "required": [
        "result",
        "fan"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "power_actions": {
          "$ref": "#/$defs/permission"
        },
        "power_off": {
          "$ref": "#/$defs/permission"
        },
        "fan_control": {
          "$ref": "#/$defs/permission"
        }
      },
      "required": [
        "power_actions",
        "power_off",
        "fan_control"
      ],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "allowed",
        "available"
      ],
      "additionalProperties": false
    },
    "grant_revoke": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        }
      },
      "required": [
        "result",
        "permissions"
      ],
      "additionalProperties": false
    },
    "keep_awake": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "keep_awake": {
          "type": "boolean"
        }
      },
      "required": [
        "result",
        "keep_awake"
      ],
      "additionalProperties": false
    },
    "playtime": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "foreground": {
          "type": "boolean"
        },
        "titles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title_id": {
                "$ref": "#/$defs/title_id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "game",
                  "app"
                ]
              },
              "total_s": {
                "type": "integer",
                "minimum": 0
              },
              "console_total_s": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "title_id",
              "name",
              "kind",
              "total_s",
              "console_total_s"
            ],
            "additionalProperties": false
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title_id": {
                "$ref": "#/$defs/title_id"
              },
              "kind": {
                "enum": [
                  "game",
                  "app"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "duration_s": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "title_id",
              "kind",
              "start",
              "duration_s"
            ],
            "additionalProperties": false
          }
        },
        "current": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "title_id": {
                  "$ref": "#/$defs/title_id"
                },
                "kind": {
                  "enum": [
                    "game",
                    "app"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_s": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "title_id",
                "kind",
                "start",
                "duration_s"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "result",
        "foreground",
        "titles",
        "sessions",
        "current"
      ],
      "additionalProperties": false
    },
    "payloads": {
      "type": "object",
      "properties": {
        "result": {
          "const": "ok"
        },
        "available": {
          "type": "boolean"
        },
        "payloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "name": {
                "type": "string"
              },
              "running": {
                "type": "boolean"
              },
              "protected": {
                "type": "boolean"
              }
            },
            "required": [
              "slot",
              "name",
              "running",
              "protected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "result",
        "available",
        "payloads"
      ],
      "additionalProperties": false
    }
  }
}
